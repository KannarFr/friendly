#!/usr/bin/env bash
#
# friendly — rewrite a dictated/typed message in a chosen tone (pro, kind,
# concise…) via the `claude` CLI, then copy the result to the clipboard.
#
# Flow: centered "Spotlight" box (wofi) to dictate/type the message
#       → "Spotlight" tone menu
#       → generation by `claude -p`
#       → copy (wl-copy) + notification.
#
set -euo pipefail

APP="Friendly"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/friendly"
PRESETS_FILE="$CONFIG_DIR/presets.conf"
# Resources (CSS, icon, text box) looked up first next to the script
# (dev / symlink), then at system install locations (AUR package).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
_res_dirs=(
  "$SCRIPT_DIR"
  "$SCRIPT_DIR/../share/friendly"
  "${XDG_DATA_HOME:-$HOME/.local/share}/friendly"
  /usr/share/friendly
  /usr/local/share/friendly
)
find_res() {
  local d
  for d in "${_res_dirs[@]}"; do
    [ -f "$d/$1" ] && { printf '%s' "$d/$1"; return 0; }
  done
  return 1
}
STYLE_FILE="$(find_res spotlight.css || true)"
ICON="$(find_res friendly.svg || true)"
INPUT_PY="$(find_res friendly-input.py || true)"
STYLE_LABEL=""   # human-readable label of the chosen tone (for notifications)

# --- helpers ---------------------------------------------------------------

die() { notify "$APP" "$1" critical; echo "$APP: $1" >&2; exit 1; }

# notify "Title" ["body"] ["urgency"]
notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "$APP" ${ICON:+-i "$ICON"} \
    -u "${3:-normal}" -h "string:x-canonical-private-synchronous:friendly" \
    "$1" "${2:-}"
}

have() { command -v "$1" >/dev/null 2>&1; }

# Run the on-cancel command (e.g. stop/discard dictation) if set; no-op otherwise.
on_cancel() { [ -n "${ON_CANCEL:-}" ] && sh -c "$ON_CANCEL" >/dev/null 2>&1 || true; }

clip_set() {
  if have wl-copy; then wl-copy
  elif have xclip; then xclip -selection clipboard
  elif have xsel; then xsel --clipboard --input
  else cat >/dev/null; die "No clipboard tool found (wl-copy/xclip/xsel)."
  fi
}

# Spotlight bar for free-form INPUT (dictation/keyboard).  spotlight_entry "Prompt"
spotlight_entry() {
  local prompt="$1"
  if have wofi; then
    printf '' | wofi --dmenu --prompt "$prompt" --cache-file /dev/null \
      --hide-scroll --width 820 --lines 0 \
      ${STYLE_FILE:+--style "$STYLE_FILE"} 2>/dev/null
  elif have rofi; then
    printf '' | rofi -dmenu -p "$prompt" -theme-str 'window {width: 820px;}' 2>/dev/null
  elif have zenity; then
    zenity --entry --title "$APP" --text "$prompt" 2>/dev/null
  else
    die "No launcher available (wofi/rofi/zenity)."
  fi
}

# Centered MULTILINE text box (GTK overlay). Fallback: single-line wofi bar.
# friendly-input.py: 0 = submitted (text on stdout), 1 = cancelled, other =
# runtime failure (e.g. layer-shell unsupported) → fall back to wofi.
spotlight_textarea() {
  local prompt="$1" rc
  # ON_OPEN: command run when the window is open/focused (e.g. dictation).
  local on_open_args=()
  [ -n "$ON_OPEN" ] && on_open_args=(--on-open "$ON_OPEN")
  if [ -n "$INPUT_PY" ] && have python3 \
     && python3 -c 'import gi; gi.require_version("GtkLayerShell","0.1")' 2>/dev/null
  then
    if python3 -B "$INPUT_PY" "${on_open_args[@]}" "$prompt"; then rc=0; else rc=$?; fi
    case "$rc" in
      0|1) return "$rc" ;;          # submitted / cancelled: propagate as-is
      *)   spotlight_entry "$prompt" ;;  # runtime failure: wofi fallback
    esac
  else
    # wofi fallback (no GTK box): still start dictation, delayed so wofi has
    # time to grab keyboard focus first.
    [ -n "$ON_OPEN" ] && ( sleep 0.2; sh -c "$ON_OPEN" ) >/dev/null 2>&1 &
    spotlight_entry "$prompt"
  fi
}

# Spotlight bar to PICK from a list.  spotlight_list "Prompt" item1 item2…
spotlight_list() {
  local prompt="$1"; shift
  if have wofi; then
    printf '%s\n' "$@" | wofi --dmenu --prompt "$prompt" --cache-file /dev/null \
      --insensitive --hide-scroll --width 820 \
      ${STYLE_FILE:+--style "$STYLE_FILE"} 2>/dev/null
  elif have rofi; then
    printf '%s\n' "$@" | rofi -dmenu -i -p "$prompt" 2>/dev/null
  elif have zenity; then
    zenity --list --title "$APP" --text "$prompt" --column "Style" "$@" 2>/dev/null
  else
    die "No launcher available (wofi/rofi/zenity)."
  fi
}

# --- presets ---------------------------------------------------------------
# Format: Name|instruction   (blank lines and # ignored)

ensure_presets() {
  [ -f "$PRESETS_FILE" ] && return
  mkdir -p "$CONFIG_DIR"
  cat >"$PRESETS_FILE" <<'EOF'
# friendly — rewrite tones.
# Format: Display name|instruction sent to the model
# The first is the default: highlighted in the menu, so Enter picks it.
Pro & kind|a tone that is both professional, kind and composed
Professional|a professional, clear and composed tone
Kind|a warm, caring and empathetic tone
Concise|a more concise and direct phrasing, keeping the essentials
Warmer|a warmer, friendlier and more positive tone
Spelling & grammar|fixing only spelling, grammar and punctuation, without changing the tone or style
EOF
}

# --- steps ------------------------------------------------------------------

get_text() {
  # 1) arguments  2) stdin (real pipe/file)  3) centered Spotlight box
  if [ "$#" -gt 0 ]; then
    printf '%s' "$*"
  elif [ -p /dev/stdin ] || [ -f /dev/stdin ]; then
    cat
  else
    # Centered text box, focus ready: voice dictation types into it.
    spotlight_textarea "Dictate your message"
  fi
}

choose_instruction() {
  ensure_presets
  local names=() instrs=() line name instr
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    name="${line%%|*}"; instr="${line#*|}"
    names+=("$name"); instrs+=("$instr")
  done <"$PRESETS_FILE"

  # Output: "label<TAB>instruction" (main splits the two).
  local i

  # Non-interactive overrides (CLI). NB: we test the "provided" flag, not the
  # content, to honor an explicit empty instruction (`-i ''`).
  if [ "$OVERRIDE_INSTRUCTION_SET" = 1 ]; then
    printf '%s\t%s' "Custom" "$OVERRIDE_INSTRUCTION"; return
  fi
  if [ -n "$OVERRIDE_STYLE" ]; then
    for i in "${!names[@]}"; do
      if [ "${names[$i]}" = "$OVERRIDE_STYLE" ]; then
        printf '%s\t%s' "${names[$i]}" "${instrs[$i]}"; return
      fi
    done
    printf '%s\t%s' "$OVERRIDE_STYLE" "$OVERRIDE_STYLE"; return  # unknown name = literal instruction
  fi

  # NB: `return 1` (not `exit`) because this function runs inside a $(...);
  # an `exit` there would only end the subshell, not the script. The caller
  # propagates the cancellation.
  local custom="✏️  Custom…"
  local choice
  choice="$(spotlight_list "Rewrite tone" "${names[@]}" "$custom")" || return 1
  [ -z "$choice" ] && return 1

  if [ "$choice" = "$custom" ]; then
    choice="$(spotlight_entry "Describe the tone")" || return 1
    [ -z "$choice" ] && return 1
    printf '%s\t%s' "Custom" "$choice"
    return
  fi

  # find the instruction of the chosen preset
  for i in "${!names[@]}"; do
    if [ "${names[$i]}" = "$choice" ]; then
      printf '%s\t%s' "${names[$i]}" "${instrs[$i]}"; return
    fi
  done
  printf '%s\t%s' "$choice" "$choice"
}

build_prompt() {
  local instr="$1" text="$2"
  cat <<EOF
Rewrite the message below applying: ${instr}.

Strict rules:
- Keep the original language of the message.
- Preserve the meaning, the facts and all important information.
- Do NOT reply to the message: rewrite it, don't answer it.
- Return ONLY the rewritten message, with no preamble, no quotes, no comment or explanation.

Message to rewrite:
<<<
${text}
>>>
EOF
}

generate() {
  local prompt="$1" out err rc
  out="$(mktemp)"; err="$(mktemp)"
  trap 'rm -f "$out" "$err"' RETURN

  local sys="You are a text rewriting tool. You return ONLY the rewritten text: no preamble (no \"Here is…\"), no explanation, no comment, no surrounding quotes. You keep the original language."
  notify "Friendly" "✍️  Rewriting…" low
  if printf '%s' "$prompt" | claude -p --append-system-prompt "$sys" >"$out" 2>"$err"; then rc=0; else rc=$?; fi
  if [ "$rc" -ne 0 ]; then
    die "claude failed: $(head -c 300 "$err")"
  fi
  cat "$out"
}

usage() {
  cat <<EOF
$APP — rewrite a message in a chosen tone, via the claude CLI.

Usage: friendly [options] [text…]
  -s, --style NAME        Use a preset by name (otherwise interactive menu).
  -i, --instruction TEXT  Free-form tone instruction (skips the menu).
  -o, --on-open CMD       Run CMD when the input box opens/focuses
                          (e.g. start dictation). Default: \$FRIENDLY_ON_OPEN.
  -c, --on-cancel CMD     Run CMD on cancel/Esc (e.g. stop dictation).
                          Default: \$FRIENDLY_ON_CANCEL.
  -n, --no-copy           Print the result to stdout instead of copying.
  -h, --help              This help.

With no text or pipe, a centered Spotlight-style box opens to dictate/type.
Tones defined in: $PRESETS_FILE
EOF
}

# --- main ------------------------------------------------------------------

OVERRIDE_INSTRUCTION=""
OVERRIDE_INSTRUCTION_SET=0
OVERRIDE_STYLE=""
ON_OPEN="${FRIENDLY_ON_OPEN:-}"     # command run when the box opens (e.g. start dictation)
ON_CANCEL="${FRIENDLY_ON_CANCEL:-}" # command run when cancelled (e.g. stop dictation)
NO_COPY=0
ARGS=()
# require an argument for options that expect one (otherwise `shift 2` would
# fail and `set -e` would kill the script with no message).
need_arg() { [ "$#" -ge 2 ] || { echo "$APP: option $1 requires an argument." >&2; usage >&2; exit 2; }; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--style)       need_arg "$@"; OVERRIDE_STYLE="$2"; shift 2 ;;
    -i|--instruction) need_arg "$@"; OVERRIDE_INSTRUCTION="$2"; OVERRIDE_INSTRUCTION_SET=1; shift 2 ;;
    -o|--on-open)     need_arg "$@"; ON_OPEN="$2"; shift 2 ;;
    -c|--on-cancel)   need_arg "$@"; ON_CANCEL="$2"; shift 2 ;;
    -n|--no-copy)     NO_COPY=1; shift ;;
    -h|--help)        usage; exit 0 ;;
    --)               shift; ARGS+=("$@"); break ;;
    *)                ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

have claude || die "The 'claude' CLI was not found in PATH."
# Fail fast BEFORE calling claude if we won't be able to copy the result
# (except in --no-copy mode, which writes to stdout).
[ "$NO_COPY" -eq 1 ] || have wl-copy || have xclip || have xsel \
  || die "No clipboard tool found (wl-copy/xclip/xsel)."

# Cancellation (Esc / close): run on-cancel (e.g. stop dictation), exit silently.
text="$(get_text "$@")" || { on_cancel; exit 0; }
# Submitted but empty: same.
[ -z "${text//[[:space:]]/}" ] && { on_cancel; exit 0; }

sel="$(choose_instruction)" || { on_cancel; exit 0; }   # Esc at the tone menu = cancel
STYLE_LABEL="${sel%%$'\t'*}"
instruction="${sel#*$'\t'}"

result="$(generate "$(build_prompt "$instruction" "$text")")"
[ -z "${result//[[:space:]]/}" ] && die "Empty response from the model."

# No-copy mode: raw output on stdout (for scripts / testing).
if [ "$NO_COPY" -eq 1 ]; then
  printf '%s\n' "$result"
  exit 0
fi

# Copy straight to the clipboard + notification with the result.
printf '%s' "$result" | clip_set
notify "✓ Copied · ${STYLE_LABEL:-rewritten}" "$result"
